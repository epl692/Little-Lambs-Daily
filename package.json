{
  "name": "little-lambs-daily",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline-first childcare daily-log PWA built on Sync-PWA-Framework",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "framework/packages/*"
  ],
  "scripts": {
    "build:ui": "vite build --config ui/vite.config.ts",
    "dev:ui": "vite build --config ui/vite.config.ts --watch",
    "check": "tsx framework/packages/app-build/src/cli.ts check-modules app.config.ts",
    "build": "npm run build:zip && npm run build:ui && tsx framework/packages/app-build/src/cli.ts build app.config.ts dist",
    "build:dev": "npm run build:zip && npm run build:ui && tsx framework/packages/app-build/src/cli.ts build app.config.ts dist --dev",
    "verify": "tsx framework/packages/app-build/src/cli.ts verify-installable dist",
    "serve": "node scripts/serve.mjs",
    "relay": "tsx framework/packages/relay-server/src/server.ts",
    "icons": "tsx scripts/make-icons.ts",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig ui/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "e2e": "npm run build:dev && playwright test",
    "build:zip": "node scripts/build-zip.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.49.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.0.0",
    "fake-indexeddb": "^6.0.0",
    "fast-check": "^3.23.2",
    "jsdom": "^25.0.0",
    "prettier": "^3.3.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
