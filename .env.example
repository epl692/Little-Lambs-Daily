# Where the app can reach the relay, as the PHONES see it. Baked into the app at build time (change it, then rebuild).
#   Trying it on this computer only:   ws://localhost:8787
#   Real use with the "tls" profile:   wss://relay.example.com
RELAY_URL=ws://localhost:8787

# Ports published on this machine (without the tls profile)
APP_PORT=8080
RELAY_PORT=8787

# How long the relay keeps photos nobody has fetched, in days
BLOB_TTL_DAYS=90

# Only for the tls profile: two names that point at this machine
APP_DOMAIN=lambs.example.com
RELAY_DOMAIN=relay.example.com
